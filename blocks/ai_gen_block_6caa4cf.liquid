{% doc %}
  @prompt
    Here is a **perfect prompt** you can give to **Shopify’s AI (Magic – Generate Section)** to build the exact “Shop The Look” section where **clicking on a dot changes the product on the right**.
    
    ---
    
    ## ✅ **Shopify AI Section Prompt (Copy/Paste)**
    
    **Title:**
    **Shop The Look – Interactive Hotspot Product Reveal Section**
    
    **Prompt:**
    Create a custom Shopify section called **“shop-the-look-hotspots”**.
    
    The section layout should contain:
    
    ### **1. Left Side – Main Image**
    
    * A large featured image (uploadable from section settings).
    * Allow **multiple hotspot dots** (at least 2).
    * Each dot can be positioned anywhere on the image using **percentage-based top/left controls**.
    * Each dot has:
    
      * Product selector (to choose a Shopify product)
      * Dot position controls (top %, left %)
      * Optional tooltip text
    * When a dot is clicked:
    
      * Highlight the active dot
      * Change the product displayed on the right side
      * Smooth fade animation when switching product
    
    ### **2. Right Side – Product Display**
    
    * Shows the selected product’s:
    
      * Featured image
      * Product title
      * Price
      * Buttons: “View Product” (link to product page)
    * Automatically updates when a dot is clicked.
    
    ### **3. Settings Required**
    
    * Section-level settings:
    
      * Main background color
      * Title text
      * Title alignment
    * Block-level settings for each hotspot:
    
      * Product picker
      * Dot position top (%)
      * Dot position left (%)
      * Dot color
      * Optional label/tooltip
    
    ### **4. Design**
    
    * Clean, simple, luxury aesthetic
    * Centered title above section
    * Hotspot dots should be circular, minimal, elegant
    * Right product card aligned vertically centered
    * Mobile responsive:
    
      * Image on top, product card below
      * Dots maintain relative positioning
    
    ### **5. Functionality**
    
    * Use simple vanilla JS inside the section file (no external libraries).
    * Add data attributes to hotspots so JS knows which product to load.
    * Fade animation when product updates.
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-look-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-shop-look-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-shop-look-title-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin-bottom: 40px;
    font-size: 32px;
    color: {{ block.settings.text_color }};
  }

  .ai-shop-look-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-shop-look-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-shop-look-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-shop-look-placeholder-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-shop-look-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
  }

  .ai-shop-look-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-shop-look-hotspot-{{ ai_gen_id }} {
    position: absolute;
    width: {{ block.settings.hotspot_size }}px;
    height: {{ block.settings.hotspot_size }}px;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 10;
  }

  .ai-shop-look-hotspot-button-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: {{ block.settings.hotspot_color }};
    border: 2px solid {{ block.settings.hotspot_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
  }

  .ai-shop-look-hotspot-button-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: {{ block.settings.hotspot_color }};
    opacity: 0.3;
    animation: ai-shop-look-pulse-{{ ai_gen_id }} 2s infinite;
  }

  @keyframes ai-shop-look-pulse-{{ ai_gen_id }} {
    0% {
      transform: scale(1);
      opacity: 0.3;
    }
    50% {
      transform: scale(1.5);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 0;
    }
  }

  .ai-shop-look-hotspot-button-{{ ai_gen_id }}::after {
    content: '+';
    font-size: 20px;
    color: {{ block.settings.hotspot_icon_color }};
    font-weight: 300;
    line-height: 1;
  }

  .ai-shop-look-hotspot-{{ ai_gen_id }}.active .ai-shop-look-hotspot-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.hotspot_active_color }};
    transform: scale(1.2);
  }

  .ai-shop-look-hotspot-{{ ai_gen_id }}:hover .ai-shop-look-hotspot-button-{{ ai_gen_id }} {
    transform: scale(1.15);
  }

  .ai-shop-look-product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: 500px;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .ai-shop-look-product-card-{{ ai_gen_id }}.fade-out {
    opacity: 0;
  }

  .ai-shop-look-product-image-{{ ai_gen_id }} {
    width: 100%;
    max-width: 300px;
    margin-bottom: 30px;
    border-radius: 8px;
    overflow: hidden;
  }

  .ai-shop-look-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-shop-look-product-title-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-shop-look-product-price-{{ ai_gen_id }} {
    font-size: 20px;
    margin-bottom: 24px;
    color: {{ block.settings.text_color }};
  }

  .ai-shop-look-product-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_background }};
  }

  .ai-shop-look-product-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_background }};
  }

  .ai-shop-look-empty-product-{{ ai_gen_id }} {
    font-size: 16px;
    color: #999;
    font-style: italic;
  }

  @media screen and (max-width: 989px) {
    .ai-shop-look-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-shop-look-title-{{ ai_gen_id }} {
      font-size: 28px;
      margin-bottom: 30px;
    }

    .ai-shop-look-product-card-{{ ai_gen_id }} {
      padding: 30px;
      min-height: 400px;
    }

    .ai-shop-look-hotspot-{{ ai_gen_id }} {
      width: calc({{ block.settings.hotspot_size }}px * 0.8);
      height: calc({{ block.settings.hotspot_size }}px * 0.8);
    }
  }
{% endstyle %}

<shop-the-look-{{ ai_gen_id }}
  class="ai-shop-look-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-shop-look-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-shop-look-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="ai-shop-look-grid-{{ ai_gen_id }}">
      <div class="ai-shop-look-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.main_image %}
          <img
            src="{{ block.settings.main_image | image_url: width: 1200 }}"
            alt="{{ block.settings.main_image.alt | escape }}"
            class="ai-shop-look-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ block.settings.main_image.width }}"
            height="{{ block.settings.main_image.height }}"
          >
        {% else %}
          <div class="ai-shop-look-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-shop-look-empty-state-{{ ai_gen_id }}">
              Add your main image to get started
            </div>
          </div>
        {% endif %}

        {% for i in (1..5) %}
          {% liquid
            assign hotspot_enabled_key = 'hotspot_' | append: i | append: '_enabled'
            assign hotspot_product_key = 'hotspot_' | append: i | append: '_product'
            assign hotspot_x_key = 'hotspot_' | append: i | append: '_x'
            assign hotspot_y_key = 'hotspot_' | append: i | append: '_y'

            assign hotspot_enabled = block.settings[hotspot_enabled_key]
            assign hotspot_product = block.settings[hotspot_product_key]
            assign hotspot_x = block.settings[hotspot_x_key]
            assign hotspot_y = block.settings[hotspot_y_key]
          %}

          {% if hotspot_enabled and hotspot_product %}
            <div
              class="ai-shop-look-hotspot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              style="left: {{ hotspot_x }}%; top: {{ hotspot_y }}%;"
              data-product-id="{{ hotspot_product.id }}"
              data-product-title="{{ hotspot_product.title | escape }}"
              data-product-price="{{ hotspot_product.price | money }}"
              data-product-url="{{ hotspot_product.url }}"
              data-product-image="{% if hotspot_product.featured_image %}{{ hotspot_product.featured_image | image_url: width: 600 }}{% endif %}"
            >
              <div class="ai-shop-look-hotspot-button-{{ ai_gen_id }}"></div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ai-shop-look-product-card-{{ ai_gen_id }}" id="ai-shop-look-product-display-{{ ai_gen_id }}">
        {% assign first_product = null %}
        {% for i in (1..5) %}
          {% liquid
            assign hotspot_enabled_key = 'hotspot_' | append: i | append: '_enabled'
            assign hotspot_product_key = 'hotspot_' | append: i | append: '_product'
            assign hotspot_enabled = block.settings[hotspot_enabled_key]
            assign hotspot_product = block.settings[hotspot_product_key]
          %}
          {% if hotspot_enabled and hotspot_product and first_product == null %}
            {% assign first_product = hotspot_product %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if first_product %}
          <div class="ai-shop-look-product-image-{{ ai_gen_id }}">
            {% if first_product.featured_image %}
              <img
                src="{{ first_product.featured_image | image_url: width: 600 }}"
                alt="{{ first_product.featured_image.alt | escape }}"
                loading="lazy"
              >
            {% endif %}
          </div>
          <h3 class="ai-shop-look-product-title-{{ ai_gen_id }}">{{ first_product.title }}</h3>
          <div class="ai-shop-look-product-price-{{ ai_gen_id }}">{{ first_product.price | money }}</div>
          <a
            href="{{ first_product.url }}"
            class="ai-shop-look-product-button-{{ ai_gen_id }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% else %}
          <div class="ai-shop-look-empty-product-{{ ai_gen_id }}">
            Enable hotspots and select products to display
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</shop-the-look-{{ ai_gen_id }}>

<script>
  (function() {
    class ShopTheLook{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.hotspots = this.querySelectorAll('.ai-shop-look-hotspot-{{ ai_gen_id }}');
        this.productDisplay = this.querySelector('#ai-shop-look-product-display-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupHotspots();
      }

      setupHotspots() {
        this.hotspots.forEach((hotspot) => {
          hotspot.addEventListener('click', () => {
            this.hotspots.forEach((h) => h.classList.remove('active'));
            hotspot.classList.add('active');
            this.updateProductDisplay(hotspot);
          });
        });
      }

      updateProductDisplay(hotspot) {
        const productTitle = hotspot.dataset.productTitle;
        const productPrice = hotspot.dataset.productPrice;
        const productUrl = hotspot.dataset.productUrl;
        const productImage = hotspot.dataset.productImage;

        this.productDisplay.classList.add('fade-out');

        setTimeout(() => {
          this.productDisplay.innerHTML = `
            <div class="ai-shop-look-product-image-{{ ai_gen_id }}">
              ${productImage ? `<img src="${productImage}" alt="${productTitle}" loading="lazy">` : ''}
            </div>
            <h3 class="ai-shop-look-product-title-{{ ai_gen_id }}">${productTitle}</h3>
            <div class="ai-shop-look-product-price-{{ ai_gen_id }}">${productPrice}</div>
            <a href="${productUrl}" class="ai-shop-look-product-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          `;

          setTimeout(() => {
            this.productDisplay.classList.remove('fade-out');
          }, 50);
        }, 300);
      }
    }

    customElements.define('shop-the-look-{{ ai_gen_id }}', ShopTheLook{{ ai_gen_id }});
  })();
</script>

