{% comment %}
  File: sections/shop-the-look-hotspots.liquid
  Description: Shop The Look section with interactive hotspots. 
  Usage: Add section in theme editor. Add main image and hotspot blocks (each picks a product and position).
{% endcomment %}

<section id="shop-the-look-{{ section.id }}" class="shop-the-look-section" style="background: {{ section.settings.background_color }};">
  <div class="container">
    {% if section.settings.title != blank %}
      <h2 class="stl-title" style="text-align: {{ section.settings.title_alignment }};">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="stl-grid">
      <div class="stl-left">
        {% if section.settings.main_image != blank %}
          <div class="stl-image-wrapper" style="--image-aspect-ratio: {{ section.settings.image_aspect_ratio }};">
            <img src="{{ section.settings.main_image | img_url: '1600x' }}" alt="{{ section.settings.main_image.alt | escape }}" class="stl-main-image" />
            {% comment %}
              Render hotspot dots. Each block should output a dot positioned by top/left % and data attributes
            {% endcomment %}
            <div class="stl-hotspots">
              {% for block in section.blocks %}
                {% if block.settings.product != blank %}
                  {% assign p = all_products[block.settings.product] %}
                  {% if p != nil %}
                    {% assign featured = p.featured_image | default: p.images.first %}
                    <button
                      type="button"
                      class="stl-hotspot {% if forloop.first %}active{% endif %}"
                      style="top: {{ block.settings.top_percent }}%; left: {{ block.settings.left_percent }}%; background: {{ block.settings.dot_color }};"
                      data-product-handle="{{ p.handle }}"
                      data-product-title="{{ p.title | escape }}"
                      data-product-url="{{ routes.product_url | append: p.handle }}"
                      data-product-price="{{ p.price_min  }}"
                      data-product-image="{{ featured | img_url: '600x' }}"
                      aria-label="{{ block.settings.label | escape }}"
                      title="{{ block.settings.label | escape }}"
                    >
                      <span class="stl-hotspot-inner"></span>
                    </button>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% else %}
          <div class="stl-empty">Upload a main image in section settings.</div>
        {% endif %}
      </div>

      <div class="stl-right">
        {% comment %}
          The right card will display the product data from the first hotspot (active) or a fallback.
        {% endcomment %}
        {% assign first_product = nil %}
        {% for block in section.blocks %}
          {% if block.settings.product != blank %}
            {% assign first_product = all_products[block.settings.product] %}
            {% break %}
          {% endif %}
        {% endfor %}

        <div class="stl-product-card" id="stl-product-card-{{ section.id }}">
          {% if first_product %}
            {% assign fp_img = first_product.featured_image | default: first_product.images.first %}
            <div class="stl-product-media fade-in">
              <img src="{{ fp_img | img_url: '600x' }}" alt="{{ first_product.title | escape }}" />
            </div>
            <div class="stl-product-info">
              <h3 class="stl-product-title">{{ first_product.title }}</h3>
              <div class="stl-product-price">{{ first_product.price_min | money }}</div>
              <a class="stl-product-link" href="/products/{{ routes.product_url | append: first_product.handle }}">View product</a>
            </div>
          {% else %}
            <div class="stl-product-empty">Add at least one hotspot block and attach a product.</div>
          {% endif %}
        </div>

      </div>
    </div>
  </div>

  <style>
    /* Basic layout */
    .shop-the-look-section { padding: 60px 0; }
    .container { max-width: 1180px; margin: 0 auto; padding: 0 20px; }
    .stl-title { font-family: serif; letter-spacing: 2px; margin-bottom: 28px; text-transform: uppercase; font-size: 22px; border-bottom: 2px solid #000; display: inline-block; padding-bottom: 8px; }

    .stl-grid { display: grid; grid-template-columns: 1fr 360px; gap: 40px; align-items: center; }
    .stl-left { position: relative; }
    .stl-image-wrapper { position: relative; width: 100%; }
    .stl-main-image { width: 100%; height: auto; display: block; object-fit: cover; }

    /* Hotspots */
    .stl-hotspots { position: absolute; inset: 0; pointer-events: none; }
    .stl-hotspot { position: absolute; transform: translate(-50%, -50%) !important; width: 22px; height: 22px; border-radius: 50%; border: 2px solid #000; display: flex; align-items: center; justify-content: center; cursor: pointer; pointer-events: auto; box-shadow: 0 2px 8px rgba(0,0,0,0.25); transition: transform .18s ease, box-shadow .18s ease; }
    .stl-hotspot .stl-hotspot-inner { width: 10px; height: 10px; border-radius: 50%; background: #000 !important; display: block; }
    .stl-hotspot:hover { transform: translate(-50%, -50%) scale(1.07); }
    .stl-hotspot.active { box-shadow: 0 6px 18px rgba(0,0,0,0.32); transform: translate(-50%, -50%) scale(1.12); }

    /* Right product card */
    .stl-product-card { background: rgba(255,255,255,0.98); padding: 22px; border-radius: 6px; text-align: center; min-height: 320px; display: flex; flex-direction: column; justify-content: center; align-items: center; }
    .stl-product-media img { width: 220px; height: auto; display:block; margin: 0 auto 18px; object-fit: cover; border-radius: 4px; }
    .stl-product-title { font-size: 16px; margin: 0 0 8px; color: #111; font-weight: 600; }
    .stl-product-price { font-size: 14px; margin-bottom: 14px; color: #666; letter-spacing: 0.6px; }
    .stl-product-link { display: inline-block; padding: 10px 14px; border: 1px solid #111; text-decoration: none; color: #111; border-radius: 4px; font-size: 13px; }
     
    .stl-empty, .stl-product-empty { padding: 30px; color: #999; text-align: center; }

    /* Fade animation */
    .fade-out { opacity: 0; transition: opacity .28s ease; }
    .fade-in { opacity: 1; transition: opacity .28s ease; }

    /* Responsive */
    @media (max-width: 900px) {
      .stl-grid { grid-template-columns: 1fr; gap: 20px; }
      .stl-right { order: 2; }
      .stl-left { order: 1; }
      .stl-product-card { min-height: 180px; padding: 16px; }
    }
    @keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.5);
        }
        100% {
            box-shadow: 0 0 0 10px rgba(255, 255, 255, 0);
        }
    }
  </style>

  <script>
    (function() {
      var root = document.getElementById('shop-the-look-{{ section.id }}');
      if (!root) return;

      var hotspots = root.querySelectorAll('.stl-hotspot');
      var card = root.querySelector('#stl-product-card-{{ section.id }}');

      function updateProductFromData(attrs) {
        if (!card) return;
        var img = card.querySelector('.stl-product-media img');
        var title = card.querySelector('.stl-product-title');
        var price = card.querySelector('.stl-product-price');
        var link = card.querySelector('.stl-product-link');

        // Fade out then update then fade in
        if (img) img.classList.add('fade-out');
        if (title) title.classList.add('fade-out');
        if (price) price.classList.add('fade-out');

        setTimeout(function() {
          if (img && attrs.image) img.src = attrs.image;
          if (title && attrs.title) title.textContent = attrs.title;
          if (price && attrs.price) price.textContent = attrs.price;
          if (link && attrs.url) link.href = `/products/${attrs.url}`;
          // Reflow fade-in
          if (img) { img.classList.remove('fade-out'); img.classList.add('fade-in'); }
          if (title) { title.classList.remove('fade-out'); title.classList.add('fade-in'); }
          if (price) { price.classList.remove('fade-out'); price.classList.add('fade-in'); }
        }, 250);
      }

      // Init: attach click handlers
      hotspots.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          // set active state
          hotspots.forEach(function(h) { h.classList.remove('active'); });
          btn.classList.add('active');

          var attrs = {
            image: btn.getAttribute('data-product-image'),
            title: btn.getAttribute('data-product-title'),
            price: btn.getAttribute('data-product-price'),
            url: btn.getAttribute('data-product-url')
          };
          updateProductFromData(attrs);
        });

        // make hotspots accessible by keyboard
        btn.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            btn.click();
          }
        });
      });

      // If no hotspots or no initial product, nothing to do
    })();
  </script>

  {% schema %}
  {
    "name": "Shop The Look – Hotspots",
    "tag": "section",
    "class": "shop-the-look-hotspots",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Section title",
        "default": "SHOP THE LOOK"
      },
      {
        "type": "select",
        "id": "title_alignment",
        "label": "Title alignment",
        "default": "center",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" },
          { "value": "right", "label": "Right" }
        ]
      },
      {
        "type": "image_picker",
        "id": "main_image",
        "label": "Main image"
      },
      {
        "type": "range",
        "id": "image_aspect_ratio",
        "label": "Main image aspect ratio (not exact position)",
        "min": 1,
        "max": 3,
        "default": 1
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#ffffff"
      }
    ],
    "blocks": [
      {
        "type": "hotspot",
        "name": "Hotspot",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label / Tooltip (optional)",
            "default": "Tooltip"
          },
          {
            "type": "range",
            "id": "top_percent",
            "label": "Dot top position (%)",
            "min": 0,
            "max": 100,
            "step": 1,
            "default": 50
          },
          {
            "type": "range",
            "id": "left_percent",
            "label": "Dot left position (%)",
            "min": 0,
            "max": 100,
            "step": 1,
            "default": 50
          },
          {
            "type": "color",
            "id": "dot_color",
            "label": "Dot color",
            "default": "#000000"
          }
        ]
      }
    ],
    "max_blocks": 8,
    "presets": [
      {
        "name": "Shop the look (hotspots)",
        "category": "Products"
      }
    ]
  }
  {% endschema %}
</section>
