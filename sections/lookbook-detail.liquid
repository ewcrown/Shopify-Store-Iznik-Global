{% comment %}
  Lookbook Detail Section

  Page metafield:
  Namespace and key: custom.images
  Type: File
  Accept: Images
  List of values: Enabled

  Usage:
  1. Create a Shopify Page
  2. Add images to custom.images
  3. Assign the template containing this section
  4. Page title appears automatically
  5. Metafield images appear below it
{% endcomment %}

<section
  id="LookbookDetail-{{ section.id }}"
  class="lookbook-detail"
>
  <div class="lookbook-detail__container">

    {% if section.settings.show_title and page.title != blank %}
      <div class="lookbook-detail__header">
        <h1 class="lookbook-detail__title">
          {{ page.title | escape }}
        </h1>
      </div>
    {% endif %}

    {% assign lookbook_images = page.metafields.custom.image.value %}

    {% if lookbook_images != blank %}
      <div class="lookbook-detail__images">

        {% for image in lookbook_images %}
          <div class="lookbook-detail__image-item">

            {{
              image
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 1000, 1200, 1500, 1800, 2000',
                sizes: '(max-width: 749px) 100vw, 1400px',
                class: 'lookbook-detail__image'
            }}

          </div>
        {% endfor %}

      </div>

    {% elsif request.design_mode %}
      <div class="lookbook-detail__empty">
        Add images to the page metafield
        <strong>custom.image</strong>
      </div>
    {% endif %}

  </div>
</section>

<style>
  /* =========================================
     LOOKBOOK DETAIL
  ========================================= */

  #LookbookDetail-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #LookbookDetail-{{ section.id }} * {
    box-sizing: border-box;
  }

  #LookbookDetail-{{ section.id }} .lookbook-detail__container {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.side_padding }}px;
    padding-right: {{ section.settings.side_padding }}px;
  }


  /* =========================================
     PAGE TITLE
  ========================================= */

  #LookbookDetail-{{ section.id }} .lookbook-detail__header {
    width: 100%;
    text-align: center;
    margin-bottom: {{ section.settings.title_bottom_spacing }}px;
  }

  #LookbookDetail-{{ section.id }} .lookbook-detail__title {
    margin: 0;
    padding: 0;

    font-size: {{ section.settings.title_size }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.title_weight }};

    text-transform: {{ section.settings.title_transform }};
    letter-spacing: {{ section.settings.title_letter_spacing }}px;

    color: {{ section.settings.title_color }};
  }


  /* =========================================
     IMAGE LIST
  ========================================= */

  #LookbookDetail-{{ section.id }} .lookbook-detail__images {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: {{ section.settings.image_gap }}px;
  }

  #LookbookDetail-{{ section.id }} .lookbook-detail__image-item {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  #LookbookDetail-{{ section.id }} .lookbook-detail__image {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }


  /* =========================================
     EMPTY STATE - THEME EDITOR ONLY
  ========================================= */

  #LookbookDetail-{{ section.id }} .lookbook-detail__empty {
    padding: 50px 20px;
    text-align: center;
    font-size: 14px;
    color: #777;
    background: #f7f7f7;
  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    #LookbookDetail-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #LookbookDetail-{{ section.id }} .lookbook-detail__container {
      padding-left: {{ section.settings.mobile_side_padding }}px;
      padding-right: {{ section.settings.mobile_side_padding }}px;
    }

    #LookbookDetail-{{ section.id }} .lookbook-detail__header {
      margin-bottom: {{ section.settings.mobile_title_bottom_spacing }}px;
    }

    #LookbookDetail-{{ section.id }} .lookbook-detail__title {
      font-size: {{ section.settings.mobile_title_size }}px;
    }

    #LookbookDetail-{{ section.id }} .lookbook-detail__images {
      gap: {{ section.settings.mobile_image_gap }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Lookbook detail",
  "tag": "section",
  "class": "section-lookbook-detail",

  "settings": [
    {
      "type": "header",
      "content": "Page title"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Mobile title size",
      "default": 16
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "select",
      "id": "title_transform",
      "label": "Title capitalization",
      "default": "uppercase",
      "options": [
        {
          "value": "none",
          "label": "Original"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ]
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "unit": "px",
      "label": "Title letter spacing",
      "default": 0
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#222222"
    },
    {
      "type": "range",
      "id": "title_bottom_spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Space below title",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_title_bottom_spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile space below title",
      "default": 20
    },

    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "range",
      "id": "image_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Space between images",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_image_gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Mobile image gap",
      "default": 6
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Maximum width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop side padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_side_padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Mobile side padding",
      "default": 12
    },

    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 20
    }
  ],

  "presets": [
    {
      "name": "Lookbook detail"
    }
  ]
}
{% endschema %}