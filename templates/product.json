f (!selectedValue) return; // nothing matched, leave current state as-is\n\n      var isStitched = selectedValue === 'stitched';\n      notice.style.display = isStitched ? 'flex' : 'none';\n    }\n\n    document.addEventListener('change', function(e) {\n      if (\n        e.target.matches('input[type=\"radio\"]') ||\n        e.target.matches('select')\n      ) {\n        updateDispatchNotice();\n      }\n    });\n\n    document.addEventListener('variant:changed', updateDispatchNotice);\n    document.addEventListener('DOMContentLoaded', updateDispatchNotice);\n    updateDispatchNotice();\n  })();\n</script>"
