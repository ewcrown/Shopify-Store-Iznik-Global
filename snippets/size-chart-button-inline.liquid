{% liquid
  assign size_chart_images = product.metafields.custom.size_chart_images.value
%}

{% if size_chart_images != blank and size_chart_images.size > 0 %}
  <side-drawer-opener
    class="size-chart-button__opener no-js-hidden"
    data-side-drawer="#SizeChartModal-{{ block.id }}"
  >
    <button
      id="SizeChartButton-{{ block.id }}"
      class="size-chart-button link button button--tertiary"
      type="button"
      aria-haspopup="dialog"
      style="
        {% if block.settings.button_width == 'full' %}
          width: 100%;
        {% elsif block.settings.button_width == 'custom' %}
          width: {{ block.settings.button_width_custom }}%;
        {% endif %}
      "
    >
      {% if block.settings.button_icon != 'none' %}
        <span class="size-chart-button__icon">
          {% render 'icon', icon: block.settings.button_icon, width: block.settings.button_icon_size %}
        </span>
      {% endif %}
      <span class="size-chart-button__text">{{ block.settings.button_text | default: 'Size Chart' }}</span>
    </button>
  </side-drawer-opener>
{% endif %}

