{%- comment -%}
  Final Size Chart Snippet
  Fix 1: Handles List Metafields correctly.
  Fix 2: Uses JavaScript "Teleport" to move the modal to the body level.
  Fix 3: Only shows trigger when selected variant is "stitched".
{%- endcomment -%}

{%- liquid 
  assign size_chart_meta = product.metafields.custom.size_chart_images.value
  assign size_chart_image = nil

  if size_chart_meta.count > 0
    assign size_chart_image = size_chart_meta | first
  else
    assign size_chart_image = size_chart_meta
  endif

  assign selected_variant_title = product.selected_or_first_available_variant.title | downcase
  assign is_unstitched = false
  if selected_variant_title contains 'unstitched'
    assign is_unstitched = true
  endif
-%}

{%- if size_chart_image != blank -%}
  <div class="sc-trigger-container sc-trigger-container--stitched"{% if is_unstitched %} style="display:none;"{% endif %}>
  <button type="button" class="sc-open-trigger" data-sc-product="{{ product.id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        <polyline points="3.27,6.96 12,12.01 20.73,6.96"></polyline>
        <line x1="12" y1="22.08" x2="12" y2="12"></line>
      </svg>
      Size Chart</button>
  </div>

  {%- comment -%} 
    The Modal stays hidden here; JS will move it to the bottom of the page 
  {%- endcomment -%}
  <div id="sc-Modal-{{ product.id }}" class="sc-modal-overlay" style="display: none;">
    <div class="sc-modal-content">  
      <div class="sc-modal-header">
        {% comment %} <h2 class="sc-header-title">{{ product.title | upcase }}</h2> {% endcomment %}
        <h2 class="sc-header-title">Size Chart</h2>
        <button type="button" class="sc-close-icon" aria-label="Close">&times;</button>
      </div>

      <div class="sc-modal-body">
        <img src="{{ size_chart_image | image_url: width: 1400 }}" 
             alt="{{ product.title }} Size Chart" 
             loading="lazy">
      </div>
    </div>
  </div>

  <style>
    .sc-open-trigger {
     display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    color: #000000;
    font-size: 14px;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    font-family: 'Jost';
    }
    .sc-trigger-container--stitched {
      margin-bottom: 1rem;
    }
    .sc-modal-overlay {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      background-color: rgba(0, 0, 0, 0.7) !important;
      z-index: 2147483647 !important;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .sc-modal-content {
      background-color: #fff;
      width: 100%;
      max-width: 700px;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
      margin: auto;
      border-radius: 6px;
    }

    .sc-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px;
      border-bottom: 1px solid #e6e6e6;
    }
    .sc-modal-body {
      padding: 20px;
    }

    .sc-open-trigger svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }

    .sc-close-icon {
      {% comment %} position: absolute; {% endcomment %}
      {% comment %} right: 15px; {% endcomment %}
      {% comment %} top: 10px; {% endcomment %}
      font-size: 36px;
      background: none;
      border: none;
      cursor: pointer;
      color: #000;
      line-height: 1;
    }

    .sc-header-title {
      font-size: 20px;
      font-weight: bold;
      margin: 0;
      letter-spacing: 1.5px;
      {% comment %} text-align: center; {% endcomment %}
    }

    .sc-modal-body img {
      width: 100%;
      height: auto;
      display: block;
    }

    body.sc-no-scroll {
      overflow: hidden !important;
    }
  </style>

  <script>
  (function () {
    function moveModals() {
      document.querySelectorAll('.sc-modal-overlay').forEach(function (m) {
        if (m.parentNode !== document.body) document.body.appendChild(m);
      });
    }

    function closeAll() {
      document.querySelectorAll('.sc-modal-overlay').forEach(function (m) {
        m.style.display = 'none';
      });
      document.body.classList.remove('sc-no-scroll');
    }

    function updateTriggers() {
      document.querySelectorAll('.sc-trigger-container--stitched').forEach(function (c) {
        var scope = c.closest('product-info, quick-add-modal, .product') || document;
        var hide = false;
        scope.querySelectorAll('variant-selects input[type="radio"]:checked, variant-selects select').forEach(function (i) {
          if ((i.value || '').trim().toLowerCase().indexOf('unstitched') !== -1) hide = true;
        });
        c.style.display = hide ? 'none' : '';
      });
    }

    // listeners sirf ek dafa lagein
    if (!window.__scInit) {
      window.__scInit = true;

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.sc-open-trigger');
        if (btn) {
          e.preventDefault();
          var modal = document.getElementById('sc-Modal-' + btn.getAttribute('data-sc-product'));
          if (modal) {
            modal.style.display = 'flex';
            document.body.classList.add('sc-no-scroll');
          }
          return;
        }
        if (e.target.closest('.sc-close-icon') || e.target.classList.contains('sc-modal-overlay')) {
          closeAll();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeAll();
      });

      document.addEventListener('change', function (e) {
        if (e.target.closest('variant-selects')) updateTriggers();
      });
      document.addEventListener('variant:changed', updateTriggers);
      document.addEventListener('shopify:section:load', function () {
        moveModals();
        updateTriggers();
      });
    }

    // har render par chalega
    moveModals();
    updateTriggers();
  })();
</script>
{%- endif -%}
