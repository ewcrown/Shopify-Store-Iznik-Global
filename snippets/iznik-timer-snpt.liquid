{% style %}
/* Container Styling */
.timer {
    background-color: #fff;
    padding: 20px;
    border-radius: 8px;
    max-width: 300px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

/* Timer Display Area */
.timer-display {
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  font-size: 1rem;
}

/* Individual Timer Block */
.timer-block {
  font-size: 1.2rem;
  text-align: center;
}

/* Number Styling */
.timer-block__num {
  font-size: 2.5rem; /* Larger font for numbers */
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 5px;
  letter-spacing: 1px; /* Slight spacing for clarity */
}

/* Unit Styling */
.timer-block__unit {
  font-size: 0.5rem;
  color: #777;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* Hover effect on blocks */
.timer-block:hover .timer-block__num {
  color: #555;
  cursor: pointer;
}

/* Responsive Design */
@media (max-width: 600px) {
  .timer {
    max-width:100% !important;
  }

  .timer-block {
    padding: 10px 15px;
  }
}
{% endstyle %}

<div class="timer">
  <div class="timer-display">
    <div class="timer-block">
      <span class="timer-block__num js-timer-days">00</span>
      <span class="timer-block__unit">Days</span>
    </div>
    <div class="timer-block">
      <span class="timer-block__num js-timer-hours">00</span>
      <span class="timer-block__unit">Hours</span>
    </div>
    <div class="timer-block">
      <span class="timer-block__num js-timer-minutes">00</span>
      <span class="timer-block__unit">Minutes</span>
    </div>
    <div class="timer-block">
      <span class="timer-block__num js-timer-seconds">00</span>
      <span class="timer-block__unit">Seconds</span>
    </div>
  </div>
</div>

{%- comment -%}
  Optional timezone selector. If you already have a timezone picker elsewhere,
  remove this block. If you use a custom timezone picker plugin, keep its init.
{%- endcomment -%}
<select id="timezone-picker" style="display:none !important;">
  <option value="Asia/Karachi" selected>Asia/Karachi</option>
  <option value="UTC">UTC</option>
  <option value="America/New_York">America/New_York</option>
  <option value="Europe/London">Europe/London</option>
  <!-- Add other zones as needed -->
</select>

<script>
  (function ($) {
    $(function () {
      // Safely output the Liquid end_date into JS (as a JSON string)
      // Ensure `end_date` is set in your section/schema or template
      const END_DATE = {{ end_date | json }};

      // Default timezone
      let targetTimezone = 'Asia/Karachi';
      let timerInterval = null;

      // Helper: pad numbers to 2 digits
      function pad2(number) {
        return String(number).padStart(2, '0');
      }

      // Get timestamp (ms) for the target end date in the selected timezone.
      // Uses moment-timezone if available; otherwise falls back to native Date parsing.
      function getTargetTimestampMs() {
        if (!END_DATE) return null;

        try {
          if (window.moment && typeof window.moment.tz === 'function') {
            // Parse the END_DATE and convert to the target timezone's moment,
            // then get milliseconds since epoch
            return moment.tz(END_DATE, targetTimezone).valueOf();
          } else {
            // Fallback: parse END_DATE as ISO using Date (no timezone conversion)
            return new Date(END_DATE).getTime();
          }
        } catch (e) {
          console.warn('Error parsing END_DATE:', e);
          return new Date(END_DATE).getTime();
        }
      }

      // Render the remaining time into the DOM
      function renderTime(msRemaining) {
        if (msRemaining <= 0) {
          $('.js-timer-days').text('0');
          $('.js-timer-hours').text('00');
          $('.js-timer-minutes').text('00');
          $('.js-timer-seconds').text('00');
          return;
        }

        const seconds = Math.floor(msRemaining / 1000);
        const days = Math.floor(seconds / (60 * 60 * 24));
        const hours = Math.floor((seconds % (60 * 60 * 24)) / (60 * 60));
        const minutes = Math.floor((seconds % (60 * 60)) / 60);
        const secs = Math.floor(seconds % 60);

        $('.js-timer-days').text(String(days));
        $('.js-timer-hours').text(pad2(hours));
        $('.js-timer-minutes').text(pad2(minutes));
        $('.js-timer-seconds').text(pad2(secs));
      }

      // Start or restart the timer
      function startTimer() {
        const targetMs = getTargetTimestampMs();
        if (!targetMs || isNaN(targetMs)) {
          console.warn('No valid target date provided for countdown.');
          return;
        }

        if (timerInterval) {
          clearInterval(timerInterval);
        }

        // Run immediately to avoid 1s delay
        function tick() {
          let nowMs;
          if (window.moment && typeof window.moment.tz === 'function') {
            nowMs = moment().tz(targetTimezone).valueOf();
          } else {
            nowMs = Date.now();
          }

          const distance = targetMs - nowMs;

          if (distance <= 0) {
            clearInterval(timerInterval);
            renderTime(0);
            $('.timer').hide(); // hide timer when finished (per original behavior)
            return;
          }

          renderTime(distance);
        }

        tick();
        timerInterval = setInterval(tick, 1000);
      }

      // Initialize timezone picker plugin if available (defensive)
      if ($('#timezone-picker').length) {
        if (typeof $.fn.timezonePicker === 'function') {
          $('#timezone-picker').timezonePicker();
        }

        // set initial targetTimezone from select value (if present)
        targetTimezone = $('#timezone-picker').val() || targetTimezone;

        // restart timer when timezone changes
        $('#timezone-picker').on('change', function () {
          const val = $(this).val();
          if (val) {
            targetTimezone = val;
            startTimer();
          }
        });
      }

      // Kick off the timer
      startTimer();
    });
  })(jQuery);
</script>